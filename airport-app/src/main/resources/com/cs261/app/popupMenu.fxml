<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="362.0" prefWidth="850.0" spacing="12.0" style="-fx-background-color: #e3edf9; -fx-padding: 10;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.UI.PopupMenuController">
    <TabPane fx:id="tabPane">
        <tabs>
            <Tab closable="false" text="Planes">
                <content>
                    <VBox spacing="8.0" style="-fx-padding: 5;">
                        <TextField fx:id="planesSearchField" prefHeight="30.0" prefWidth="240.0" promptText="Search by callsign" style="-fx-background-color: white;-fx-border-color: #c8d8e8;-fx-border-radius: 6;-fx-background-radius: 6;-fx-font-size: 12px;-fx-padding: 4 8;" />
                        <TableView fx:id="planesTable" prefHeight="220.0" style="-fx-background-radius: 10; -fx-border-radius: 10;">
                            <columns>
                                <TableColumn fx:id="planesCallsignColumn" prefWidth="100.0" text="Callsign" />
                                <TableColumn fx:id="planesOperatorColumn" prefWidth="125.0" text="Operator" />
                                <TableColumn fx:id="planesOriginColumn" prefWidth="99.0" text="Origin" />
                                <TableColumn fx:id="planesDestinationColumn" prefWidth="181.0" text="Destination" />
                                <TableColumn fx:id="planesFlightTypeColumn" prefWidth="235.0" text="Flight type" />
                                <TableColumn fx:id="planesEmergencyStatusColumn" prefWidth="160.0" text="Emergency status" />
                                <TableColumn fx:id="planesEmergencyStartColumn" prefWidth="160.0" text="Emergency start" />
                            </columns>
                        </TableView>
                    </VBox>
                </content>
            </Tab>
            <Tab closable="false" text="Runways">
                <content>
                    <VBox spacing="8.0" style="-fx-padding: 5;">
                        <TextField fx:id="runwaysSearchField" prefHeight="30.0" prefWidth="240.0" promptText="Search by runway ID..." style="-fx-background-color: white;-fx-border-color: #c8d8e8;-fx-border-radius: 6;-fx-background-radius: 6;-fx-font-size: 12px;-fx-padding: 4 8;" />
                        <TableView fx:id="runwaysTable" prefHeight="220.0" style="-fx-background-radius: 10; -fx-border-radius: 10;">
                            <columns>
                                <TableColumn fx:id="runwaysIdColumn" prefWidth="100.0" text="Runway ID" />
                                <TableColumn fx:id="runwaysOperationModeColumn" prefWidth="120.0" text="Operational mode" />
                                <TableColumn fx:id="runwaysStatusColumn" prefWidth="95.0" text="Runway Status" />
                                <TableColumn fx:id="runwaysHasInterruptionColumn" prefWidth="116.5" text="Has interruption" />
                                <TableColumn fx:id="runwaysStatusChangeTo" prefWidth="95.5" text="Status change" />
                                <TableColumn fx:id="runwaysInterruptionStartColumn" prefWidth="145.5" text="Interruption start" />
                                <TableColumn fx:id="runwaysInterruptionEndColumn" prefWidth="146.5" text="Interruption End" />
                            </columns>
                        </TableView>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
    <Button fx:id="btnClose" onAction="#closePopup" style="-fx-background-color: #1a3a5c;-fx-text-fill: white;-fx-background-radius: 6;-fx-cursor: hand;-fx-padding: 8 20;" text="Close" />
</VBox>
