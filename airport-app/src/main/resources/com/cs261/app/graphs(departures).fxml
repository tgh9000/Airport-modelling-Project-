<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="480.0" prefWidth="720.0" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.UI.TableNavController" stylesheets="@../teststyle.css">

    <VBox prefHeight="480.0" prefWidth="140.0" spacing="0" style="-fx-background-color: #1a3a5c;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0">
        <HBox alignment="CENTER" prefHeight="80.0" style="-fx-background-color: #122840; -fx-cursor: hand;">
            <Button alignment="CENTER" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#goHome" prefHeight="86.0" prefWidth="140.0" style="-fx-background-color: transparent;-fx-cursor: hand;" HBox.hgrow="ALWAYS">
                <graphic>
                    <ImageView fitHeight="101.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@logoNoBack.png" /></image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <Button fx:id="btnHome" onAction="#goHome" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" style="-fx-background-color: transparent;-fx-text-fill: #a8c8e8;-fx-font-size: 13px;-fx-font-family: 'Segoe UI', sans-serif;-fx-font-weight: 600;-fx-cursor: hand;-fx-border-color: transparent transparent #1e4a72 transparent;-fx-border-width: 0 0 1 0;-fx-padding: 0 0 0 20;" text="Home" />
        <Button fx:id="btnDepartures" onAction="#goToDepartures" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" style="-fx-background-color: #2a5a8c;-fx-text-fill: white; -fx-font-size: 13px; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: 700; -fx-cursor: hand; -fx-border-color: transparent transparent #1e4a72 transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 0 20; -fx-border-left-width: 4; -fx-border-color: #4da6ff transparent transparent transparent;" text="Departures" />
        <Button fx:id="btnArrivals" onAction="#goToArrivals" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" style="-fx-background-color: transparent;-fx-text-fill: #a8c8e8;-fx-font-size: 13px;-fx-font-family: 'Segoe UI', sans-serif;-fx-font-weight: 600;-fx-cursor: hand;-fx-border-color: transparent transparent #1e4a72 transparent;-fx-border-width: 0 0 1 0;-fx-padding: 0 0 0 20;" text="Arrivals" />
        <Button fx:id="btnQueue" onAction="#goToQueue" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" style="-fx-background-color: transparent;-fx-text-fill: #a8c8e8;-fx-font-size: 13px;-fx-font-family: 'Segoe UI', sans-serif;-fx-font-weight: 600;-fx-cursor: hand;-fx-border-color: transparent transparent #1e4a72 transparent;-fx-border-width: 0 0 1 0;-fx-padding: 0 0 0 20;" text="Take-Off Queue" />
        <Button fx:id="btnHolding" onAction="#goToHolding" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" style="-fx-background-color: transparent;-fx-text-fill: #a8c8e8;-fx-font-size: 13px;-fx-font-family: 'Segoe UI', sans-serif;-fx-font-weight: 600;-fx-cursor: hand;-fx-border-color: transparent transparent #1e4a72 transparent;-fx-border-width: 0 0 1 0;-fx-padding: 0 0 0 20;" text="Holding Pattern" />
        <Button fx:id="btnRunways" onAction="#goToRunways" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" style="-fx-background-color: transparent;-fx-text-fill: #a8c8e8;-fx-font-size: 13px;-fx-font-family: 'Segoe UI', sans-serif;-fx-font-weight: 600;-fx-cursor: hand;-fx-border-color: transparent transparent #1e4a72 transparent;-fx-border-width: 0 0 1 0;-fx-padding: 0 0 0 20;" text="Runways" />
        <Button fx:id="btnGraphs" onAction="#goToGraphs" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" style="-fx-background-color: transparent;-fx-text-fill: #a8c8e8;-fx-font-size: 13px;-fx-font-family: 'Segoe UI', sans-serif;-fx-font-weight: 600;-fx-cursor: hand;-fx-border-color: transparent transparent #1e4a72 transparent;-fx-border-width: 0 0 1 0;-fx-padding: 0 0 0 20;" text="Graphs" />
    </VBox>

    <VBox spacing="14.0" style="-fx-background-color: #f0f4f8;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="140" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <padding>
            <Insets bottom="18" left="20" right="20" top="18" />
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ComboBox fx:id="timestampComboBox" promptText="Insert Timestamp here" prefHeight="36.0" prefWidth="340.0" style="-fx-background-color: white;-fx-border-color: #c8d8e8;-fx-border-radius: 6;-fx-background-radius: 6;-fx-font-size: 13px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" />
            <Button fx:id="btnSearch" onAction="#onSearch" prefHeight="36.0" prefWidth="60.0" style="-fx-background-color: #2a7ae2;-fx-text-fill: white;-fx-font-size: 14px;-fx-border-radius: 6;-fx-background-radius: 6;-fx-cursor: hand;" text="Search" />
        </HBox>
        <Label style="-fx-font-size: 16px;-fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: 700;-fx-text-fill: #1a3a5c;" text="Departures — Timing Analysis" textFill="#4b4846" />

        <!-- ═════════════════════════════════════════ -->
        <!-- CHART CARD                                -->
        <!-- ═════════════════════════════════════════ -->
        
        <VBox style="-fx-background-color: white;-fx-background-radius: 10;-fx-border-color: #dce8f4;-fx-border-radius: 10;-fx-effect: dropshadow(gaussian, rgba(0,50,120,0.08), 12, 0, 0, 3);" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>

            <LineChart fx:id="arrivalsGraph" animated="true" createSymbols="true" style="-fx-font-family: 'Segoe UI', sans-serif;-fx-font-size: 11px;" title="" VBox.vgrow="ALWAYS">

                <xAxis>
                    <CategoryAxis label="Timestamp (ticks)" style="-fx-font-family: 'Segoe UI', sans-serif;-fx-font-size: 11px;-fx-text-fill: #5a7a9a;" fx:id="xAxis" />
                </xAxis>

                <yAxis>
                    <NumberAxis fx:id="yAxis" label="Δ Expected vs Actual Departure (seconds)" side="LEFT" style="-fx-font-family: 'Segoe UI', sans-serif;-fx-font-size: 11px;-fx-text-fill: #5a7a9a;" tickLabelFill="#4b4846" />
                </yAxis>
            </LineChart>
        </VBox>
    </VBox>

</AnchorPane>
