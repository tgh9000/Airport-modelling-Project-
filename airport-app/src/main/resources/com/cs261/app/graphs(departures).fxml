<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="480.0" prefWidth="720.0" stylesheets="@../teststyle.css" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.UI.DeparturesGraphController">


    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SIDEBAR                                             -->
    <!-- ═══════════════════════════════════════════════════ -->
    <VBox prefHeight="480.0" prefWidth="140.0" spacing="0" style="-fx-background-color:  #1a3a5c;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0">

        <!-- Logo / Home area -->
        <HBox alignment="CENTER" prefHeight="80.0" style="-fx-background-color: #122840; -fx-cursor: hand;">
            <Button alignment="CENTER_LEFT" mnemonicParsing="false" prefHeight="52.0" prefWidth="140.0" style="-fx-background-color: transparent; -fx-text-fill: #a8c8e8; -fx-font-size: 13px; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: 600; -fx-cursor: hand; -fx-border-color: transparent transparent #1e4a72 transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 0 0;" HBox.hgrow="ALWAYS" text="Statistics">
            <!-- <graphic>
               <ImageView fitHeight="101.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@logoNoBack.png" />
                  </image>
               </ImageView>
            </graphic> -->
            </Button>
        </HBox>

        <!-- Nav Buttons -->

        <Button fx:id="btnDepartures" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" styleClass="menuBtn" text="Departures" />


        <Button fx:id="btnArrivals" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" styleClass="menuBtn" text="Arrivals" onAction="#goArrivals" />

        


    </VBox>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- MAIN CONTENT AREA                                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <VBox spacing="14.0" style="-fx-background-color: #f0f4f8;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="140" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <padding>
            <Insets bottom="18" left="20" right="20" top="18" />
        </padding>

        <!-- Page Title -->
        <Label style="-fx-font-size: 16px;-fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: 700;-fx-text-fill: #1a3a5c;" text="Departures — Timing Analysis" textFill="#4b4846" />

        <!-- ═════════════════════════════════════════ -->
        <!-- CHART CARD                                -->
        <!-- ═════════════════════════════════════════ -->
        
        <VBox style="-fx-background-color: white;-fx-background-radius: 10;-fx-border-color: #dce8f4;-fx-border-radius: 10;-fx-effect: dropshadow(gaussian, rgba(0,50,120,0.08), 12, 0, 0, 3);" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>

            <LineChart fx:id="arrivalsGraph" animated="true" createSymbols="true" style="-fx-font-family: 'Segoe UI', sans-serif;-fx-font-size: 11px;" title="" VBox.vgrow="ALWAYS">

                <xAxis>
                    <NumberAxis label="Timestamp (ticks)" style="-fx-font-family: 'Segoe UI', sans-serif;-fx-font-size: 11px;-fx-text-fill: #5a7a9a;" fx:id="xAxis" />
                </xAxis>

                <yAxis>
                    <NumberAxis fx:id="yAxis" label="Δ Expected vs Actual Departure (seconds)" side="LEFT" style="-fx-font-family: 'Segoe UI', sans-serif;-fx-font-size: 11px;-fx-text-fill: #5a7a9a;" tickLabelFill="#4b4846" />
                </yAxis>
            </LineChart>
        </VBox>
    </VBox>

</AnchorPane>
