<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="1000.0" prefWidth="1000.0" styleClass="startpageBg" stylesheets="@../teststyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.UI.Navigation">
   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="100.0" StackPane.alignment="CENTER">
         <children>
            <Label styleClass="landingTitle" text="Airport Simulator"/>
               <VBox alignment="CENTER" prefHeight="100.0" maxWidth="500.0" spacing="20">
                  <children>
                     <Button alignment="BOTTOM_CENTER" onAction="#goToSecondPage" prefHeight="21.0" styleClass="landingBtn1" text="Load New Simulation" />
                     <Button alignment="BOTTOM_CENTER" onAction="#goToCompare" prefHeight="21.0" styleClass="landingBtn1" text="Compare Previous Simulations" />
                     <Button alignment="BOTTOM_CENTER" prefHeight="21.0" onAction="#openUserGuide"  styleClass="landingBtn1" text="User Guide" />
                  </children>
               </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
