<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="480.0" prefWidth="720.0" stylesheets="@../teststyle.css" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.UI.TablesDeparturesController">
   <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
      
         <!-- ═══════════════════════════════════════════════════ -->
         <!-- SIDEBAR                                             -->
         <!-- ═══════════════════════════════════════════════════ -->
         <VBox prefHeight="480.0" prefWidth="140.0" spacing="0" style="-fx-background-color: #1a3a5c;">
   
                  <!-- Logo / Home area -->
            <HBox alignment="CENTER" prefHeight="80.0" style="-fx-background-color: #122840; -fx-cursor: hand;">
               <Button fx:id="btnHome" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#goHome" prefHeight="52.0" prefWidth="140.0" style="-fx-background-color: transparent; -fx-text-fill: #a8c8e8; -fx-font-size: 13px; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: 600; -fx-cursor: hand; -fx-border-color: transparent transparent #1e4a72 transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 0 0;" HBox.hgrow="ALWAYS" text="Statistics">
                  <!-- <graphic>
                     <ImageView fitHeight="101.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@logoNoBack.png" />
                        </image>
                     </ImageView>
                  </graphic> -->
               </Button>
            </HBox>
   
            <!-- Nav Buttons -->
            <Button fx:id="btnDepartures" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" styleClass="menuBtn" text="Departures" />
      
            <Button fx:id="btnArrivals" onAction = "#goArrival" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" styleClass="menuBtn" text="Arrivals" />
   
            <Button fx:id="btnQueue" onAction = "#goQueue" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" styleClass="menuBtn" text="Take Off Queue" />
   
            <Button fx:id="btnHolding" onAction = "#goHolding" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" styleClass="menuBtn" text="Holding Pattern" />
   
            <Button fx:id="btnRunways" onAction = "#goRunway" alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" styleClass="menuBtn" text="Runways" />
   
         
   
         </VBox>
      
               <!-- ═══════════════════════════════════════════════════ -->
         <!-- MAIN CONTENT AREA                                   -->
         <!-- ═══════════════════════════════════════════════════ -->
         <VBox spacing="14.0" style="-fx-background-color: #f0f4f8;" HBox.hgrow="ALWAYS">
   
                  <padding>
                  <Insets bottom="18" left="20" right="20" top="18" />
              </padding>
            <VBox>
               <children>
            
                          <!-- TOP BAR: Search + Back button -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
            
                              <!-- Search Field -->
                              
                        <TextField fx:id="timestampField" prefHeight="36.0" prefWidth="340.0" promptText="Enter start Timestamp (Number of minutes)" style="-fx-background-color: white;-fx-border-color: #c8d8e8;-fx-border-radius: 6;-fx-background-radius: 6;-fx-font-size: 13px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;-fx-padding: 0 10 0 10;" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="timestampField1" prefHeight="36.0" prefWidth="340.0" promptText="Enter end Timestamp (Number of minutes)" style="-fx-background-color: white;-fx-border-color: #c8d8e8;-fx-border-radius: 6;-fx-background-radius: 6;-fx-font-size: 13px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;-fx-padding: 0 10 0 10;" HBox.hgrow="ALWAYS" />
                              <!-- Search Button -->
                        <Button fx:id="btnSearch" maxHeight="-Infinity" maxWidth="-Infinity" onAction="#searchByTimestamp" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: #2a7ae2;-fx-text-fill: white;-fx-font-size: 14px;-fx-border-radius: 6;-fx-background-radius: 6;-fx-cursor: hand;" text="🔍" />
                        <Button fx:id="reset" maxHeight="-Infinity" maxWidth="-Infinity" onAction="#resetTable" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: #2a7ae2;-fx-text-fill: white;-fx-font-size: 14px;-fx-border-radius: 6;-fx-background-radius: 6;-fx-cursor: hand;" text="reset" />
            
                              <!-- Spacer -->
                        <HBox prefHeight="30.0" prefWidth="154.0" HBox.hgrow="NEVER" />
                    </HBox>
                  <HBox alignment="CENTER">
                     <children>
                        <Label fx:id = "errorMessageLabel"  alignment="CENTER" text="*Example error message*" textFill="#b91313">
                           <HBox.margin>
                              <Insets top="5.0" />
                           </HBox.margin>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </VBox>
      
               <!-- ═════════════════════════════════════════ -->
               <!-- CHART CARD                                -->
               <!-- ═════════════════════════════════════════ -->
               <VBox style="-fx-background-color: white;-fx-background-radius: 10;-fx-border-color: #dce8f4;-fx-border-radius: 10;-fx-effect: dropshadow(gaussian, rgba(0,50,120,0.08), 12, 0, 0, 3);" VBox.vgrow="ALWAYS">
      
                  <padding>
                      <Insets bottom="20" left="30" right="30" top="20" />
                  </padding>
                  <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="341.0" prefWidth="478.0" VBox.vgrow="ALWAYS">
                     <children>
            
                        <VBox spacing="15" HBox.hgrow="ALWAYS">
         
                           <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Departures Data" />
         
                           <TableView fx:id="DeparturesTable" prefHeight="400" style="-fx-background-radius: 10; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
         
                              <columns>
                                    <TableColumn fx:id="callsignColumn" maxWidth="1.7976931348623157E308" prefWidth="150" text="Plane Callsign" /> 
                                    <TableColumn fx:id="runwayColumn" maxWidth="1.7976931348623157E308" prefWidth="150" text="Runway" />
                                    <TableColumn fx:id="scheduledColumn" maxWidth="1.7976931348623157E308" prefWidth="150" text="Scheduled departure time" />
                                    <TableColumn fx:id="actualColumn" maxWidth="1.7976931348623157E308" prefWidth="150" text="Actual departure time" />
                                    <TableColumn fx:id="exitColumn" maxWidth="1.7976931348623157E308" prefWidth="150" text="Exit time of simulation" />
                              </columns>
         
                           </TableView>
            
                           <!-- Pagination Controls -->
                           <HBox alignment="CENTER_RIGHT" spacing="10">
                              <Button onAction="#prev" text="◀" />
                              <Button onAction="#next" text="▶" />
                           </HBox>
            
                        </VBox>
                     </children>
                  </HBox>
                  
               </VBox>
      
            </VBox>
      </children>
   </HBox>

   <HBox alignment="CENTER_RIGHT" prefHeight="480.0" prefWidth="41.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
         <Button fx:id="btnDetailsToggle" onAction="#toggleDetailsPane" prefHeight="36.0" prefWidth="36.0" style="-fx-background-color: #c8d8e8;-fx-text-fill: #1a3a5c;-fx-font-size: 14px;-fx-border-radius: 6;-fx-background-radius: 6;-fx-cursor: hand;" text="◀" />
      </children>
   </HBox>
   <VBox fx:id="detailsPane" managed="false" prefWidth="280.0" spacing="12.0" style="-fx-background-color: #1a3a5c; -fx-padding: 10;" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
         <fx:include fx:id="popupMenu" source="popupMenu.fxml" />
      </children>
   </VBox>

</AnchorPane>
