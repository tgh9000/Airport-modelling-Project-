<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Tooltip?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@../teststyle.css" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.UI.TableNavController">

    <VBox prefHeight="480.0" prefWidth="140.0" spacing="0" style="-fx-background-color: #1a3a5c;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0">
        <HBox alignment="CENTER" prefHeight="80.0" style="-fx-background-color: #122840; -fx-cursor: hand;">
            <Button alignment="CENTER" mnemonicParsing="false" prefHeight="86.0" prefWidth="140.0" style="-fx-background-color: transparent;-fx-cursor: hand;" HBox.hgrow="ALWAYS">
                <graphic>
                    <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@companyLogo.png" /></image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <!--    <Button fx:id="btnHome"  alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="140.0" style="-fx-background-color: #2a5a8c;-fx-text-fill: white;-fx-font-size: 13px;-fx-font-family: 'Segoe UI', sans-serif;-fx-font-weight: 700;-fx-cursor: hand;-fx-border-color: transparent transparent #1e4a72 transparent;-fx-border-width: 0 0 1 0;-fx-padding: 0 0 0 20;-fx-border-left-width: 4;-fx-border-color: #4da6ff transparent transparent transparent;" text="Home" />    -->
        <Button fx:id="btnTables" alignment="CENTER_LEFT" onAction="#goToDepartures" prefHeight="52.0" prefWidth="140.0" styleClass="menuBtn" text="Tables" />
        <Button fx:id="btnGraphs" alignment="CENTER_LEFT" onAction="#goToGraphs" prefHeight="52.0" prefWidth="140.0" styleClass="menuBtn" text="Graphs" />
        <Button fx:id="btnExitOutputPg" alignment="CENTER_LEFT" onAction="#gotoLanding" prefHeight="52.0" prefWidth="140.0" styleClass="menuBtn" text="Exit Simulation" />
    </VBox>

    <VBox spacing="14.0" style="-fx-background-color: #f0f4f8;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="140" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <padding>
            <Insets bottom="18" left="20" right="20" top="18" />
        </padding>

        <VBox>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <TextField fx:id="timestampField" prefHeight="36.0" prefWidth="340.0" promptText="Insert Timestamp here" style="-fx-background-color: white;-fx-border-color: #c8d8e8;-fx-border-radius: 6;-fx-background-radius: 6;-fx-font-size: 13px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;-fx-padding: 0 10 0 10;" />
                    <Button fx:id="btnSearch" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: #2a7ae2;-fx-text-fill: white;-fx-font-size: 14px;-fx-border-radius: 6;-fx-background-radius: 6;-fx-cursor: hand;" text="🔍" />
                    <HBox prefHeight="30.0" prefWidth="154.0" HBox.hgrow="ALWAYS" />
                </HBox>
            </children>
        </VBox>

        <Label style="-fx-font-size: 20px;-fx-font-family: 'Segoe UI', sans-serif;-fx-font-weight: 700;-fx-text-fill: #1a3a5c;" text="Key performance indicators" />
        <Label fx:id="kpiMaxDelayTakeoff" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Maximum delay for take-off: — Minutes" />
        <Label fx:id="kpiAvgDelayTakeoff" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Average delay for take-off: — Minutes" />
        <Label fx:id="kpiAvgWaitTakeOff" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Average take-off queue wait time:  — Minutes" />
        <Label fx:id="kpiMaxDelayArrival" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Maximum delay for arrival: — Minutes" />
        <Label fx:id="kpiAvgDelayArrival" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Average delay for arrival: — Minutes" />
        <Label fx:id="kpiAvgWaitArrival" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Average holding queue wait time:  — Minutes" />
        <Label fx:id="kpiIncomingCancelled" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Number of incoming planes cancelled: —" />
        <Label fx:id="kpiOutgoingDiverted" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Number of outgoing planes diverted: —" />
        <Label fx:id="kpiRunways" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Number of Runways: — (— incoming, — outgoing, — mixed)" />
        <Label fx:id="kpiHPLength" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Maximum holding queue length: —" />
        <Label fx:id="kpiTQLength" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Maximum take-off queue length: —" />        
        <Label fx:id="kpiMaxWaitCancellation" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Maximum wait time for cancellation: — Minutes" />
        <Label fx:id="kpiMaxWaitDiversion" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Maximum wait time for diversion: — Minutes" />
        <Label fx:id="kpiDuration" style="-fx-font-size: 14px;-fx-font-family: 'Segoe UI', sans-serif;-fx-text-fill: #333;" text="Duration of simulation: —" />    
    </VBox>

    <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <Button fx:id="btnDetailsToggle" onAction="#toggleDetailsPane" prefHeight="36.0" prefWidth="36.0" style="-fx-background-color: #c8d8e8;-fx-text-fill: #1a3a5c;-fx-font-size: 14px;-fx-border-radius: 6;-fx-background-radius: 6;-fx-cursor: hand;" text="◀" />
        </children>
    </HBox>

    <VBox fx:id="detailsPane" managed="false" prefWidth="280.0" spacing="12.0" style="-fx-background-color: #e3edf9; -fx-padding: 10;" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <TabPane fx:id="detailsTabPane">
                <tabs>
                    <Tab text="Planes">
                        <content>
                            <VBox spacing="8.0" style="-fx-padding: 5;">
                                <TextField fx:id="planesSearchField" prefHeight="30.0" prefWidth="240.0" promptText="Search by callsign or ID..." style="-fx-background-color: white;-fx-border-color: #c8d8e8;-fx-border-radius: 6;-fx-background-radius: 6;-fx-font-size: 12px;-fx-padding: 4 8;" />
                                <TableView fx:id="planesTable" prefHeight="220.0" style="-fx-background-radius: 10; -fx-border-radius: 10;">
                                    <columns>
                                        <TableColumn fx:id="planesIdColumn" prefWidth="100.0" text="Callsign" />
                                        <TableColumn fx:id="planesDetailColumn" prefWidth="160.0" text="Details" />
                                    </columns>
                                </TableView>
                            </VBox>
                        </content>
                    </Tab>
                    <Tab text="Runways">
                        <content>
                            <VBox spacing="8.0" style="-fx-padding: 5;">
                                <TextField fx:id="runwaysSearchField" prefHeight="30.0" prefWidth="240.0" promptText="Search by runway ID..." style="-fx-background-color: white;-fx-border-color: #c8d8e8;-fx-border-radius: 6;-fx-background-radius: 6;-fx-font-size: 12px;-fx-padding: 4 8;" />
                                <TableView fx:id="runwaysTable" prefHeight="220.0" style="-fx-background-radius: 10; -fx-border-radius: 10;">
                                    <columns>
                                        <TableColumn fx:id="runwaysIdColumn" prefWidth="100.0" text="Runway ID" />
                                        <TableColumn fx:id="runwaysDetailColumn" prefWidth="160.0" text="Details" />
                                    </columns>
                                </TableView>
                            </VBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
            <Button fx:id="btnCloseDetails" onAction="#closeDetailsPane" style="-fx-background-color: #1a3a5c;-fx-text-fill: white;-fx-background-radius: 6;-fx-cursor: hand;-fx-padding: 8 20;" text="Close" />
        </children>
    </VBox>
</AnchorPane>
