<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="100.0" prefWidth="100.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.UI.RunwayInputController" styleClass="runwayVbox">
   <children>
      <Label fx:id="runwayLabel" text="Runway 1">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <HBox prefHeight="20.0" prefWidth="200.0">
         <children>
            <Label text="Runway Length (Metres)">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <TextField fx:id="lengthField" promptText="e.g. 3902" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="15.0" />
               </font>
               <HBox.margin>
                  <Insets left="40.0" right="20.0" />
               </HBox.margin>
            </TextField>
         </children>
      </HBox>
      <HBox prefHeight="20.0" prefWidth="200.0">
         <children>
            <Label text="Bearing (Degrees)">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <TextField fx:id="bearingField" promptText="e.g. 90" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="15.0" />
               </font>
               <HBox.margin>
                  <Insets left="40.0" right="20.0" />
               </HBox.margin>
            </TextField>
         </children>
      </HBox>
      <HBox prefHeight="20.0" prefWidth="200.0">
         <children>
            <Label text="Operating mode: ">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <ComboBox fx:id="modeBox" prefWidth="150.0" />
         </children>
      </HBox>
      <VBox fx:id="interruptionBox" prefHeight="200.0" prefWidth="100.0">
         <children>
         </children>
      </VBox>
      <HBox prefHeight="30.0" prefWidth="560.0">
         <children>
            <Button styleClass="form-button" mnemonicParsing="false" onAction="#addInterruption" prefHeight="25.0" prefWidth="140.0" text="Add interruption" />
            <Region prefHeight="25.0" prefWidth="120.0" HBox.hgrow="ALWAYS" />
            <Button styleClass="secondary-button" mnemonicParsing="false" onAction="#removeSection" text="Remove interruption" />
         </children>
         <padding>
            <Insets bottom="10.0" />
         </padding>
      </HBox>
   </children>
</VBox>
