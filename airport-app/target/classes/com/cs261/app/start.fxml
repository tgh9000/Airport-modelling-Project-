<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<StackPane prefHeight="1000.0" prefWidth="1000.0" style="-fx-background-color: #A6BEDA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.Navigation">
   <children>
      <VBox alignment="CENTER" spacing="48.0" StackPane.alignment="CENTER" style="-fx-padding: 40;">
         <children>
            <Label styleClass="title-label" text="Team 36 Airport Modelling" />
            <ImageView fitHeight="120.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@companyLogo.png" />
               </image>
            </ImageView>
            <VBox alignment="CENTER" spacing="14.0">
               <children>
                  <Button styleClass="primary-button" minWidth="220.0" mnemonicParsing="false" onAction="#goToSecondPage" text="Load new simulation" />
                  <Button styleClass="secondary-button" minWidth="220.0" mnemonicParsing="false" onAction="#goToResults" text="View results (temp)" />
                  <Button styleClass="secondary-button" minWidth="220.0" mnemonicParsing="false" onAction="#closeApp" text="Close application" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
