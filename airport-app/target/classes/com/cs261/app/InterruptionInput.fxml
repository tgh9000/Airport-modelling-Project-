<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="200.0" prefWidth="100.0" fx:id="interruptionBox" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller = "com.cs261.app.InterruptionInputController">
    <HBox prefHeight="20.0" prefWidth="200.0">
        <children>
            <Label text="Operational Status:">
                <font>
                <Font size="18.0" />
                </font>
            </Label>
            <ComboBox fx:id="statusBox" prefWidth="150.0" />
        </children>
    </HBox>
    <HBox prefHeight="100.0" prefWidth="200.0">
        <children>
            <Label text="Start Time">
                <padding>
                <Insets right="10.0" />
                </padding></Label>
            <TextField prefHeight="21.0" prefWidth="59.0" promptText="Days">
                <font>
                <Font size="10.0" />
                </font>
            </TextField>
            <Label text=":" />
            <TextField prefHeight="21.0" prefWidth="59.0" promptText="Hours">
                <font>
                <Font size="10.0" />
                </font>
            </TextField>
            <Label text=":" />
            <TextField prefHeight="21.0" prefWidth="59.0" promptText="Minutes">
                <font>
                <Font size="10.0" />
                </font>
            </TextField>
            <Label text="Duration (minutes)">
                <padding>
                <Insets left="10.0" />
                </padding></Label>
            <TextField HBox.hgrow="ALWAYS">
                <font>
                <Font size="10.0" />
                </font>
                <HBox.margin>
                <Insets left="10.0" right="20.0" />
                </HBox.margin>
            </TextField>
        </children>
    </HBox>
    
</VBox>