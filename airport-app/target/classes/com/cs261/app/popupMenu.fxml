<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="popup-panel" alignment="TOP_LEFT" prefWidth="280.0" spacing="12.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.PopupMenuController">
   <children>
      <TabPane fx:id="tabPane">
         <tabs>
            <Tab text="Planes">
               <content>
                  <VBox spacing="8.0">
                     <children>
                        <TextField fx:id="planesSearchField" promptText="Search by callsign or ID..." />
                        <TableView fx:id="planesTable" prefHeight="220.0">
                           <columns>
                              <TableColumn fx:id="planesIdColumn" prefWidth="100.0" text="Callsign" />
                              <TableColumn fx:id="planesDetailColumn" prefWidth="160.0" text="Details" />
                           </columns>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Runways">
               <content>
                  <VBox spacing="8.0">
                     <children>
                        <TextField fx:id="runwaysSearchField" promptText="Search by runway ID..." />
                        <TableView fx:id="runwaysTable" prefHeight="220.0">
                           <columns>
                              <TableColumn fx:id="runwaysIdColumn" prefWidth="100.0" text="Runway ID" />
                              <TableColumn fx:id="runwaysDetailColumn" prefWidth="160.0" text="Details" />
                           </columns>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
      <Button styleClass="close-button" mnemonicParsing="false" onAction="#closePopup" text="Close" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
