<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="1000.0" prefWidth="1000.0" style="-fx-background-color: #A6BEDA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.NewSim">
   <children>
      <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="540.0" prefWidth="600.0" StackPane.alignment="CENTER">
         <children>
            <ScrollPane styleClass="form-card" fitToHeight="true" fitToWidth="true" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="500.0" prefWidth="620.0" style="-fx-padding: 16;">
               <content>
                  <VBox fx:id="runwayBox" prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <HBox prefHeight="20.0" prefWidth="200.0">
                           <children>
                              <Label text="What is the Desired length of the Simulation?">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <HBox prefHeight="50.0" prefWidth="200.0">
                           <children>
                              <TextField fx:id="simDaysField" promptText="Days">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </TextField>
                              <Label text=":">
                                 <font>
                                    <Font size="30.0" />
                                 </font>
                              </Label>
                              <TextField  fx:id="simHoursField" promptText="Hours">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </TextField>
                              <Label text=":">
                                 <font>
                                    <Font size="30.0" />
                                 </font>
                              </Label>
                              <TextField  fx:id="simMinutesField" promptText="Minutes">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </TextField>
                           </children>
                        </HBox>
                        <HBox prefHeight="20.0" prefWidth="200.0">
                           <children>
                              <Label text="Runways:">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        
                        



















                        
                        <HBox prefHeight="30.0" prefWidth="560.0">
                           <children>
                              <Button styleClass="form-button" mnemonicParsing="false" onAction="#addSection" text="Add Runway" />
                              <Region prefHeight="42.0" prefWidth="352.0" HBox.hgrow="ALWAYS" />
                              <Button styleClass="secondary-button" mnemonicParsing="false" onAction="#removeSection" text="Remove runway" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
            <HBox alignment="BOTTOM_LEFT" prefHeight="40.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
               <children>
                  <Button styleClass="secondary-button" mnemonicParsing="false" onAction="#goBack" prefHeight="36.0" prefWidth="90.0" text="Back" />
                  <Label fx:id="errorMessageLabel" alignment="CENTER_LEFT" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" prefHeight="40.0" style="-fx-font-size: 13px; -fx-text-fill: #c0392b;" wrapText="true" HBox.hgrow="ALWAYS" />
                <Button styleClass="primary-button" mnemonicParsing="false" onAction="#checkSim" prefHeight="36.0" prefWidth="90.0" text="Start" />
               </children></HBox>
         </children>
      </AnchorPane>
   </children>
</StackPane>
