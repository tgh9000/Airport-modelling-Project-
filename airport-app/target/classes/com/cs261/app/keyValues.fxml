<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="TOP_LEFT" hgap="48.0" vgap="14.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.KeyValuesController">
   <columnConstraints>
      <ColumnConstraints halignment="LEFT" minWidth="320.0" />
      <ColumnConstraints halignment="LEFT" minWidth="140.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints minHeight="30.0" />
      <RowConstraints minHeight="30.0" />
      <RowConstraints minHeight="30.0" />
      <RowConstraints minHeight="30.0" />
      <RowConstraints minHeight="30.0" />
      <RowConstraints minHeight="30.0" />
      <RowConstraints minHeight="30.0" />
      <RowConstraints minHeight="30.0" />
      <RowConstraints minHeight="30.0" />
      <RowConstraints minHeight="30.0" />
      <RowConstraints minHeight="30.0" />
   </rowConstraints>
   <children>
      <Label styleClass="title-label" text="Key values" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2" />
      <Label styleClass="key-value-label" text="Maximum delay for take-off:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <Label fx:id="maxDelayTakeOffLabel" styleClass="key-value-value" text="— Minutes" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <Label styleClass="key-value-label" text="Average Delay for take off:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      <Label fx:id="avgDelayTakeOffLabel" styleClass="key-value-value" text="— Minutes" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <Label styleClass="key-value-label" text="Maximum delay for arrival:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
      <Label fx:id="maxDelayArrivalLabel" styleClass="key-value-value" text="— Minutes" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      <Label styleClass="key-value-label" text="Average Delay for arrival:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
      <Label fx:id="avgDelayArrivalLabel" styleClass="key-value-value" text="— Minutes" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      <Label styleClass="key-value-label" text="Number of incoming Planes cancelled:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
      <Label fx:id="cancelledLabel" styleClass="key-value-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="5" />
      <Label styleClass="key-value-label" text="Number of outgoing planes diverted:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
      <Label fx:id="divertedLabel" styleClass="key-value-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="6" />
      <Label styleClass="key-value-label" text="Number of Runways:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
      <Label fx:id="runwaysLabel" styleClass="key-value-value" text="— (— incoming, — outgoing, — mixed)" GridPane.columnIndex="1" GridPane.rowIndex="7" />
      <Label styleClass="key-value-label" text="Maximum Wait time (for cancellation):" GridPane.columnIndex="0" GridPane.rowIndex="8" />
      <Label fx:id="maxWaitCancellationLabel" styleClass="key-value-value" text="— Minutes" GridPane.columnIndex="1" GridPane.rowIndex="8" />
      <Label styleClass="key-value-label" text="Maximum Wait time (for diversion):" GridPane.columnIndex="0" GridPane.rowIndex="9" />
      <Label fx:id="maxWaitDiversionLabel" styleClass="key-value-value" text="— minutes" GridPane.columnIndex="1" GridPane.rowIndex="9" />
      <Label styleClass="key-value-label" text="Duration of simulation:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
      <Label fx:id="durationLabel" styleClass="key-value-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="10" />
   </children>
   <padding>
      <Insets bottom="32.0" left="32.0" right="32.0" top="24.0" />
   </padding>
</GridPane>
