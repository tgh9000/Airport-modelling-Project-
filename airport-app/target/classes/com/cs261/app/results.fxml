<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cs261.app.ResultsController">
   <left>
      <VBox fx:id="sidebar" styleClass="sidebar" alignment="TOP_LEFT" prefWidth="170.0" spacing="8.0">
         <children>
            <Button fx:id="btnHome" styleClass="sidebar-button" maxWidth="Infinity" minHeight="40.0" mnemonicParsing="false" onAction="#goToHome" text="Home" />
            <Button fx:id="btnDepartures" styleClass="sidebar-button" maxWidth="Infinity" minHeight="40.0" mnemonicParsing="false" onAction="#goToDepartures" text="Departures" />
            <Button fx:id="btnArrivals" styleClass="sidebar-button" maxWidth="Infinity" minHeight="40.0" mnemonicParsing="false" onAction="#goToArrivals" text="Arrivals" />
            <Button fx:id="btnRunways" styleClass="sidebar-button" maxWidth="Infinity" minHeight="40.0" mnemonicParsing="false" onAction="#goToRunways" text="Runways" />
            <Button fx:id="btnGraphs" styleClass="sidebar-button" maxWidth="Infinity" minHeight="40.0" mnemonicParsing="false" onAction="#goToGraphs" text="Graphs" />
         </children>
      </VBox>
   </left>
   <center>
      <VBox alignment="TOP_LEFT" fillWidth="true">
         <children>
            <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <TextField fx:id="timestampField" promptText="Insert Timestamp here" style="-fx-pref-width: 240;" />
                  <Button mnemonicParsing="false" onAction="#cycleTimestampBack" text="◀" />
                  <Button mnemonicParsing="false" onAction="#cycleTimestampForward" text="▶" />
                  <Button mnemonicParsing="false" onAction="#togglePopup" text="Planes / Runways" />
               </children>
            </HBox>
            <StackPane fx:id="contentArea" style="-fx-background-color: #FFFFFF;" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </center>
   <right>
      <StackPane fx:id="popupPane" prefWidth="280.0" visible="false" managed="false" />
   </right>
</BorderPane>
